#!/usr/bin/env bash
# Write a new fortune in $EDITOR and add it to this year's file in fortunes/,
# creating the file in a new year. An empty entry, or one with a line holding
# only `%`, is rejected and the draft is kept.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
file="$root/fortunes/$(date +%Y).txt"

# The draft is removed once it's added, or if it's empty. Otherwise it's kept
# and its path printed, whether the entry was rejected, the editor failed or
# the script was interrupted.
draft="$(mktemp "${TMPDIR:-/tmp}/fortune.XXXXXX")"
trap '[ ! -e "$draft" ] || echo "scribe: draft kept in $draft" >&2' EXIT
"${EDITOR:-vi}" "$draft"

# Drop trailing whitespace on each line, and blank lines at either end.
entry="$(sed -e 's/[[:space:]]*$//' "$draft" | sed -e '/./,$!d')"
if [ -z "$entry" ]; then
  rm "$draft"
  echo "scribe: empty fortune, nothing added" >&2
  exit 1
fi
if grep -qx '%' <<< "$entry"; then
  echo "scribe: a line holding only % would split the fortune" >&2
  exit 1
fi

# Separate it from the last entry, which may not end in a newline.
if [ -s "$file" ]; then
  [ -z "$(tail -c1 "$file")" ] || echo >> "$file"
  echo '%' >> "$file"
fi
printf '%s\n' "$entry" >> "$file"
rm "$draft"

# Recompile the .dat if strfile is around, as the build will.
if command -v strfile > /dev/null; then
  strfile -s "$file"
fi

echo "Added to fortunes/$(basename "$file")."
