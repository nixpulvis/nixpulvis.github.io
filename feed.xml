---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
{%
assign ramblings = site.ramblings
                 | concat: site.mathematics
                 | sort: 'date'
                 | reverse
%}
<feed xmlns="http://www.w3.org/2005/Atom" xml:base="{{ '/' | absolute_url }}">
  <id>{{ '/ramblings' | absolute_url }}</id>
  <title>nixpulvis - Ramblings</title>
  <author><name>Nathan Lilienthal</name></author>
  <link rel="self" href="{{ page.url | absolute_url }}" />
  <link rel="alternate" type="text/html" href="{{ '/ramblings' | absolute_url }}" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {% for rambling in ramblings %}
    {% if rambling.hidden or rambling.draft or rambling.archived %}
      {% continue %}
    {% endif %}
    <entry>
      <id>{{ rambling.url | absolute_url }}</id>
      <title>{{ rambling.title | xml_escape }}</title>
      <link rel="alternate" type="text/html" href="{{ rambling.url | absolute_url }}" />
      <published>{{ rambling.date | date_to_xmlschema }}</published>
      <updated>{{ rambling.last_modified_at | default: rambling.date | date_to_xmlschema }}</updated>
      <content type="html">{{ rambling.content | xml_escape }}</content>
    </entry>
  {% endfor %}
</feed>
