---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:base="{{ site.absolute_url("/") }}">
  <id>{{ site.absolute_url("/ramblings") }}</id>
  <title>{{ Site::TITLE }} - Ramblings</title>
  <author><name>Nathan Lilienthal</name></author>
  <link rel="self" href="{{ site.absolute_url(page.url.as_str()) }}" />
  <link rel="alternate" type="text/html" href="{{ site.absolute_url("/ramblings") }}" />
  <updated>{{ site.xml_time() }}</updated>
  {% for rambling in site.ramblings() %}
    {% if rambling.front.hidden || rambling.front.draft || rambling.front.archived %}
      {% continue %}
    {% endif %}
    <entry>
      <id>{{ site.absolute_url(rambling.url.as_str()) }}</id>
      <title>{{ site.escape(rambling.title().as_str()) }}</title>
      <link rel="alternate" type="text/html" href="{{ site.absolute_url(rambling.url.as_str()) }}" />
      <published>{{ site.xml_date(rambling) }}</published>
      <updated>{{ site.xml_date(rambling) }}</updated>
      <content type="html">{{ site.escape(rambling.content.as_str()) }}</content>
    </entry>
  {% endfor %}
</feed>
