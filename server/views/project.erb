<%# Project layout: title and reference links from metadata.
     Mirrors _layouts/project.md. References are URLs stored in the
     metadata JSON (e.g. GitHub repos related to the project). %>
<h2><%= @page[:title] %></h2>

<% if @meta['references'] && !@meta['references'].empty? %>
<ul class="references">
<% @meta['references'].each do |ref| %>
    <li><a href="<%= ref %>"><%= ref %></a></li>
<% end %>
</ul>
<% end %>

<%= @content %>
